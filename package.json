{
  "name": "framemodeler-web",
  "version": "1.1.0",
  "description": "本プロジェクトは、C# WinFormsで作られた建築構造フレームモデリングCADツール「Ebi_FrameModeler」を、GitHub Pagesで動作するWebアプリケーションに変換するものである。",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check": "npm run format:check && npm run typecheck && npm run typecheck:test && npm run lint && npm run test:coverage && npm run build && npm run check:bundle"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "three": "^0.186.1",
    "yaml": "^2.9.1"
  }
}
